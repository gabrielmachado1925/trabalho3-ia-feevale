# ==============================================================================
# .gitignore - Trabalho 3: Inteligência Artificial (Universidade Feevale)
# ==============================================================================

# Ambientes virtuais
.venv/
env/
venv/
ENV/
.env/
env.bak/
venv.bak/

# Python: Caches e arquivos compilados
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
.coverage
htmlcov/

# Microsoft Word / Office: Arquivos temporários e de travamento (lock files)
~$*.docx
~$*.doc
~$*.xlsx
~$*.xls
~$*.pptx
~$*.ppt

# Relatórios em Word e modelos (apenas o PDF oficial em docs/ é publicado)
docs/*.docx
docs/*.doc
*_backup*.docx
*backup*.docx
*_backup*.doc
*backup*.doc
Modelo-Relatorio.docx

# Documentação interna de desenvolvimento e planejamento (mantida localmente)
docs/*.md

# macOS: Metadados do sistema operacional
.DS_Store
*/.DS_Store
**/.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Editores de código e IDEs
.vscode/
.idea/
*.swp
*.swo
*~
*.sublime-project
*.sublime-workspace
.directory

# Jupyter / IPython
.ipynb_checkpoints/

# Arquivos de log e temporários genéricos
*.tmp
*.log.tmp
